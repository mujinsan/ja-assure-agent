GEMINI_API_KEY=your_key_from_aistudio.google.com
GEMINI_MODEL=gemini-3.6-flash
# tried in order on the same key when the model above hits its quota or vanishes
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.5-flash
# image generation model; falls back to a branded Pillow card if unavailable
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# optional: fallback provider used when Gemini returns 429/quota exhausted
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# optional: live competitor/trend research
TAVILY_API_KEY=
# Project 2 worker. Real posting needs BOTH this key and the "Live posting"
# toggle armed in the app (stored in the DB, default OFF). Without both, the
# worker stays dry-run and appends posts to outbox.jsonl.
AYRSHARE_API_KEY=
POLL_SECONDS=10
DB_PATH=ja_assure.db
